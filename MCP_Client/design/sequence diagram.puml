            group get_bedrock_client() 
                group Try
                    Agent -> Agent: CAll from function create_llm_model triggers ths function to create client for accessing AWS AI models
                    Agent -> Agent: The function get_bedrock_client returns thr client for boto3 models
                    Agent -> Agent: Create client to access LLM models from boto3 by providing service_name and region_name and return it
                end group
                group Except
                    Agent -> Agent: Refer except block of create_agent_instance() function for error logging in database and raising custom exception to user
                end group
            end group
            group custom_error_handler(error)
                alt if error of type StructuredOutputValidationError
                    Agent -> Agent: Return the custom message to LLM for retrying
                else if error of type MultipleStructuredOutputsError
                    Agent -> Agent: Return the custom message to LLM for retrying & to pick the best suitable format
                else
                    Agent -> Agent:  Return the error message to LLM
                end
            end group
    end group
@enduml